# Copy this file to .env and fill in the values for local development.
# In production, set these in your Cloudflare Pages project settings.

# Password to log in to /admin
ADMIN_PASSWORD=your-secure-password-here

# Secret key for signing session tokens — use a long random string (32+ chars)
JWT_SECRET=replace-with-a-long-random-secret-string

# GitHub Personal Access Token with "repo" scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repository in owner/repo format
GITHUB_REPO=elegrange11-star/astro-sphere

# Branch to commit changes to
GITHUB_BRANCH=main
