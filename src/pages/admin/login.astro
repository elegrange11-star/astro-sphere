---
export const prerender = false

import { getSession } from "../../lib/auth"

if (await getSession(Astro.request)) {
  return Astro.redirect("/admin")
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — Elizabeth Le Grange</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f9fafb;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 2rem;
      width: 100%;
      max-width: 360px;
    }
    h1 { font-size: 1rem; font-weight: 500; color: #111; margin-bottom: 1.5rem; }
    label { display: block; font-size: 0.75rem; font-weight: 500; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.375rem; }
    input[type="password"] {
      width: 100%;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      outline: none;
      transition: border-color 0.15s;
    }
    input[type="password"]:focus { border-color: #6b7280; }
    button[type="submit"] {
      width: 100%;
      background: #111;
      color: #fff;
      border: none;
      border-radius: 4px;
      padding: 0.625rem;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      margin-top: 1rem;
      transition: background 0.15s;
    }
    button[type="submit"]:hover { background: #374151; }
    button[type="submit"]:disabled { background: #9ca3af; cursor: not-allowed; }
    .error {
      color: #dc2626;
      font-size: 0.75rem;
      margin-top: 0.5rem;
      display: none;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Admin Login</h1>
    <form id="login-form">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required autofocus />
      <p class="error" id="error-msg">Incorrect password. Please try again.</p>
      <button type="submit" id="submit-btn">Login</button>
    </form>
  </div>

  <script is:inline>
    const form = document.getElementById('login-form')
    const errorMsg = document.getElementById('error-msg')
    const submitBtn = document.getElementById('submit-btn')

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      errorMsg.style.display = 'none'
      submitBtn.disabled = true
      submitBtn.textContent = 'Logging in...'

      const formData = new FormData(form)
      try {
        const res = await fetch('/api/auth/login', { method: 'POST', body: formData })
        if (res.ok) {
          window.location.href = '/admin'
        } else {
          errorMsg.style.display = 'block'
          submitBtn.disabled = false
          submitBtn.textContent = 'Login'
        }
      } catch {
        errorMsg.style.display = 'block'
        submitBtn.disabled = false
        submitBtn.textContent = 'Login'
      }
    })
  </script>
</body>
</html>
