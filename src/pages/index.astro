---
import PageLayout from "../layouts/PageLayout.astro"
import artworksData from "../data/artworks.json"

const artworks = [...artworksData.artworks].sort((a, b) => a.order - b.order)

type Artwork = typeof artworks[0]
type Row =
  | { type: "solo"; artwork: Artwork }
  | { type: "group"; key: string; artworks: Artwork[] }

const rows: Row[] = []
const seenGroups = new Set<string>()

for (const artwork of artworks) {
  if (artwork.group) {
    if (!seenGroups.has(artwork.group)) {
      const groupArtworks = artworks.filter((a) => a.group === artwork.group)
      rows.push({ type: "group", key: artwork.group, artworks: groupArtworks })
      seenGroups.add(artwork.group)
    }
  } else {
    rows.push({ type: "solo", artwork })
  }
}
---

<PageLayout title="Home" description="Portfolio of Elizabeth Le Grange">

  <div class="relative bg-white dark:bg-black min-h-screen">
    <div class="mx-auto max-w-screen-2xl p-5 space-y-24 pt-16 pb-24">

      <section class="space-y-24">

        {rows.map((row) =>
          row.type === "solo" ? (
            <div class="space-y-3 flex flex-col items-center">
              <div class="w-full bg-neutral-50 dark:bg-neutral-900 overflow-hidden shadow-sm flex justify-center">
                <img
                  src={row.artwork.src}
                  alt={row.artwork.alt}
                  class="w-full max-w-2xl h-auto object-contain max-h-[85vh]"
                />
              </div>
              <div class="text-center space-y-1 max-w-xl">
                <h2 class="text-lg font-serif tracking-wide text-black dark:text-white italic">
                  {row.artwork.title}
                </h2>
                <p class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 dark:text-neutral-500 font-light">
                  {row.artwork.medium} &bull; {row.artwork.dimensions} &bull; {row.artwork.year}
                </p>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 font-light leading-relaxed">
                  {row.artwork.description}
                </p>
              </div>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start w-full max-w-6xl mx-auto">
              {row.artworks.map((artwork) => (
                <div class="space-y-4 flex flex-col items-center w-full">
                  <div class="w-full bg-neutral-50 dark:bg-neutral-900 overflow-hidden shadow-sm flex justify-center p-4 min-h-[350px] items-center">
                    <img
                      src={artwork.src}
                      alt={artwork.alt}
                      class="w-full h-auto object-contain max-h-[60vh]"
                    />
                  </div>
                  <div class="text-center space-y-2 px-2">
                    <h2 class="text-xl font-serif tracking-wide text-black dark:text-white italic">
                      {artwork.title}
                    </h2>
                    <p class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 dark:text-neutral-500 font-light">
                      {artwork.medium} &bull; {artwork.dimensions} &bull; {artwork.year}
                    </p>
                    <p class="text-xs text-neutral-500 dark:text-neutral-400 font-light leading-relaxed max-w-md mx-auto">
                      {artwork.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          )
        )}

      </section>

    </div>
  </div>

</PageLayout>
