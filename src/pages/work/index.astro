---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { SITE } from "@consts"

const collection = await getCollection("work")

collection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return input

  const month = input.toLocaleDateString("en-US", {
    month: "short",
  })

  const year = new Date(input).getFullYear()
  return `${month} ${year}`
}
---

<PageLayout title="Work" description="Professional history and creative timelines of Elizabeth Le Grange">
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
        Work History
      </h1>
      <div class="mt-1 text-neutral-500 dark:text-neutral-400 font-light text-sm">
        A timeline of professional history, textile design, and jewelry management.
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate space-y-8">
      {work.map((item) => (
        <div class="space-y-1">
          <div class="text-sm font-semibold text-black dark:text-white">
            {item.data.company}
          </div>
          <div class="text-xs text-neutral-500 dark:text-neutral-400">
            {item.data.role} &bull; {formatWorkDate(item.data.dateStart)} - {item.data.dateEnd ? formatWorkDate(item.data.dateEnd) : "Present"}
          </div>
          <div class="text-sm text-neutral-700 dark:text-neutral-300 font-light pt-1 leading-relaxed">
            <item.Content />
          </div>
        </div>
      ))}
    </div>
  </BottomLayout>
</PageLayout>
}
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {WORK.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <ul>
      { 
        work.map((entry) => (
          <li class="animate border-b border-black/10 dark:border-white/25 mt-4 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
            <div class="text-sm uppercase mb-4">
              {formatWorkDate(entry.data.dateStart)} - {formatWorkDate(entry.data.dateEnd)}
            </div>
            <div class="text-black dark:text-white font-semibold">
              {entry.data.company}
            </div>
            <div class="text-sm font-semibold">
              {entry.data.role}
            </div>
            <article class="prose dark:prose-invert">
              <entry.Content />
            </article>
          </li>
        ))
      }
    </ul>
  </BottomLayout>
</PageLayout>
